# ---------------------------------------------------------------------------
# School Results Portal — environment
#
# Copy to .env and fill in.  Never commit .env (ARCHITECTURE.md §11).
#
# This file lists the keys in use as of milestone 1.  Each later milestone adds
# its own keys here as it lands (see docs/DECISIONS.md, D11) — auth secrets in
# milestone 2, object storage in milestone 11, Sentry in milestone 13.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# development | production
APP_ENV=development
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
# Used by the api service.  Must be the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://portal:portal@postgres:5432/portal

# Consumed by the postgres service to initialise the cluster.  Keep in step
# with DATABASE_URL above.
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal
POSTGRES_DB=portal

# The test suite empties every table between tests, so it never runs against
# the database above.  Leave this unset and it uses DATABASE_URL's database
# name with "_test" appended, creating and migrating it on first run
# (docs/DECISIONS.md D46).  Set it only to point the suite somewhere else.
# TEST_DATABASE_URL=postgresql+asyncpg://portal:portal@postgres:5432/portal_test

# --- Origins ---------------------------------------------------------------
# The API has its own hostname (docs/DECISIONS.md, D13).  In production the two
# must share one registrable domain — portal.example.ng and api.example.ng —
# so browser requests stay same-site and the refresh cookie can keep
# SameSite=Lax.

# The single origin allowed to call the API from a browser.  Never "*": the
# refresh cookie is sent with credentials.  Used from milestone 2.
PUBLIC_WEB_ORIGIN=http://localhost:8080

# Where the browser reaches the web app.
NEXT_PUBLIC_SITE_URL=http://localhost:8080

# Where the browser reaches the API.  Baked into the client bundle at build
# time, so it must be the public hostname, not the container name.
NEXT_PUBLIC_API_URL=http://api.localhost:8080

# Where the web container reaches the API for server-side rendering — the
# short path across the Docker network, never leaving the host.
INTERNAL_API_URL=http://api:8000

# --- Auth (§5.1) -----------------------------------------------------------
# Signing key for access tokens. The API REFUSES TO START in production if
# this is left at the development value or is shorter than 32 bytes.
# Generate one with:
#   python -c 'import secrets; print(secrets.token_urlsafe(64))'
JWT_SECRET=dev-only-not-a-secret-change-me-before-production

# Defaults match §5.1; override only with a reason.
# ACCESS_TOKEN_MINUTES=30
# REFRESH_TOKEN_DAYS=30
# MAX_FAILED_ATTEMPTS=5
# LOCKOUT_MINUTES=15

# --- Caddy (production only) ----------------------------------------------
# Real hostnames make Caddy provision and renew TLS automatically.
# Both must sit under the same registrable domain.
API_DOMAIN=api.example.ng
WEB_DOMAIN=portal.example.ng
