# ---------------------------------------------------------------------------
# School Results Portal — environment
#
# Copy to .env and fill in.  Never commit .env (ARCHITECTURE.md §11).
#
# This file lists the keys in use as of milestone 1.  Each later milestone adds
# its own keys here as it lands (see docs/DECISIONS.md, D11) — auth secrets in
# milestone 2, object storage in milestone 11, Sentry in milestone 13.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# development | production
APP_ENV=development
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
# Used by the api service.  Must be the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://portal:portal@postgres:5432/portal

# Consumed by the postgres service to initialise the cluster.  Keep in step
# with DATABASE_URL above.
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal
POSTGRES_DB=portal

# --- Web -------------------------------------------------------------------
# Origin the browser uses.  Same-origin through Caddy (ARCHITECTURE.md §14 A11).
NEXT_PUBLIC_SITE_URL=http://localhost:8080
# Origin the web container uses for server-side fetches, inside the network.
INTERNAL_API_URL=http://api:8000

# --- Caddy (production only) ----------------------------------------------
# A domain makes Caddy provision TLS automatically; :80 serves plain HTTP.
SITE_ADDRESS=:80
