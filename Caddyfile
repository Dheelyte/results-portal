# Development reverse proxy.
#
# The API lives on its own hostname, mirroring production, where it is
# api.<domain> alongside the web app at <domain> (docs/DECISIONS.md, D13).
# Development models the split so that CORS, cookie scope and preflight
# behaviour are exercised here rather than discovered after a deploy.
#
# Caddy listens on 8080 inside the container as well as out, so the Host
# header's port matches the site address exactly.
#
# *.localhost resolves to loopback without an /etc/hosts entry on most
# systems. If yours does not, add:
#
#     127.0.0.1  api.localhost
#
# See docs/DECISIONS.md D13 for the .test alternative, which mirrors
# production's same-site cookie behaviour more exactly.

{
	# No automatic HTTPS in development; there is no domain to provision for.
	auto_https off
	admin off
}

# --- API -------------------------------------------------------------------
http://api.localhost:8080 {
	reverse_proxy api:8000

	encode gzip

	log {
		output stdout
		format json
	}
}

# --- Web app ---------------------------------------------------------------
# 127.0.0.1 is accepted as well so a bare IP still reaches the front page.
http://localhost:8080, http://127.0.0.1:8080 {
	# reverse_proxy upgrades websockets automatically, which next dev's
	# hot-module reload needs.
	reverse_proxy web:3000

	encode gzip

	log {
		output stdout
		format json
	}
}
